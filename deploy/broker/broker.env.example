# Copy to /etc/asix-broker/broker.env (mode 600). scripts/deploy/bootstrap-broker.sh does this for you.

# Where the ASIX data node's HTTP ingest lane is (the nginx front door of the platform).
ASIX_INGEST_URL=https://asix1:30443/v1/ingest/http
# Optional: defaults to the ingest URL with /v1/ingest/http replaced by /v1/ingest/heartbeat
#ASIX_HEARTBEAT_URL=https://asix1:30443/v1/ingest/heartbeat

# One ingestion key per broker: Settings > Collectors > Installers > create, then paste it here.
ASIX_INGEST_KEY=asix_ik_REPLACE_ME

# Name shown on the Collectors page (letters, digits . _ : - , up to 100 chars).
ASIX_BROKER_NAME=broker-1

# Vector 0.59+ no longer substitutes ${VAR} in its config unless this is set (bootstrap-broker.sh writes it; older Vector ignores it).
VECTOR_DANGEROUSLY_ALLOW_ENV_VAR_INTERPOLATION=true

# Port the broker listens on for syslog, UDP and TCP. 514 is what devices expect by default.
ASIX_SYSLOG_PORT=514

# Time zone the senders write in, for syslog lines that carry none (RFC 3164, the common "Oct 19 18:44:27 host app: msg" form).
# Vector reads those as UTC, so a sender in Toronto looks four hours early. An IANA name, for example America/Toronto; unset or UTC changes
# nothing. bootstrap-broker.sh --timezone writes it. RFC 5424 lines carry their own offset and are not affected.
#ASIX_SYSLOG_TIMEZONE=America/Toronto

# CA bundle used to verify the data node's certificate. For the self-signed nginx certificate, copy
# that certificate here and point to it. Default is the system bundle.
#ASIX_CA_FILE=/etc/asix-broker/ca.pem

# Syslog over TLS (RFC 5425). bootstrap-broker.sh --tls-cert/--tls-key writes these for you. They only matter
# together with VECTOR_CONFIG, which makes Vector load the second file (deploy/broker/vector-tls.yaml).
#VECTOR_CONFIG=/etc/vector/vector.yaml,/etc/vector/vector-tls.yaml
#ASIX_SYSLOG_TLS_PORT=6514
#ASIX_TLS_CERT_FILE=/etc/asix-broker/tls/server.crt
#ASIX_TLS_KEY_FILE=/etc/asix-broker/tls/server.key
# Mutual TLS: only senders with a certificate from this CA are accepted.
#ASIX_TLS_CA_FILE=/etc/asix-broker/tls/client-ca.pem
#ASIX_TLS_VERIFY_CLIENT=true

# More inputs: log FILES, HTTP/JSON and the systemd JOURNAL. All optional extra config files, joined to VECTOR_CONFIG (the list above gets them appended:
#   VECTOR_CONFIG=/etc/vector/vector.yaml,/etc/vector/vector-tls.yaml,/etc/vector/vector-file.yaml,/etc/vector/vector-http.yaml,/etc/vector/vector-journald.yaml
# bootstrap-broker.sh writes the list for you; docs/broker-vm.md, "More inputs: files and HTTP".
# Files: --file-glob. One glob; each new line is sent with source type "file". The vector user must be able to read the files.
#ASIX_FILE_GLOB=/var/log/myapp/*.log
# HTTP: --http-user and --http-password-file (--http-port, --http-tls). POST JSON to http(s)://BROKER:PORT/events with basic authentication,
# source type "http". There is no default user or password: Vector refuses to start the HTTP input without both.
#ASIX_HTTP_USER=svc
#ASIX_HTTP_PASSWORD=REPLACE_ME_12_OR_MORE_CHARS
#ASIX_HTTP_PORT=8088
# HTTPS for the HTTP input, with the certificate of the syslog-over-TLS listener (needs ASIX_TLS_CERT_FILE and ASIX_TLS_KEY_FILE above).
#ASIX_HTTP_TLS=true
# Journal: --journald (and --journald-priority). Every new entry of this VM's systemd journal is sent with source type "journald"; the vector user is
# added to the systemd-journal group so it may read it. Only entries at least this important are sent: 0 emerg ... 6 info (default) ... 7 debug.
#ASIX_JOURNALD_MAX_PRIORITY=6

# Config from ASIX (bootstrap-broker.sh --accept-config writes the first line; --config-pubkey writes the second).
#ASIX_ACCEPT_CONFIG=true
# With this set the broker acts only on config that ASIX signed with the matching private key (the file may hold several public keys).
#ASIX_CONFIG_PUBKEY_FILE=/etc/asix-broker/config-signing.pub
# How far (seconds) a signed answer's time may be from this machine's clock. Default 600.
#ASIX_CONFIG_MAX_SKEW_S=600
